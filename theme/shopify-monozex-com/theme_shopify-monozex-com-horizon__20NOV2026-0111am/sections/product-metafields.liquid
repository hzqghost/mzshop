{% liquid
  assign visible_count = 0
  for block in section.blocks
    assign namespace = block.settings.namespace | strip
    assign key = block.settings.key | strip
    assign field = product.metafields[namespace][key]
    if field != blank
      assign visible_count = visible_count | plus: 1
    endif
  endfor
%}

{% if visible_count > 0 %}
  <section class="product-meta page-width" aria-labelledby="product-meta-title-{{ section.id }}">
    <div class="product-meta__heading">
      <p>At a glance</p>
      <h2 id="product-meta-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    <dl class="product-meta__grid">
      {% for block in section.blocks %}
        {% liquid
          assign namespace = block.settings.namespace | strip
          assign key = block.settings.key | strip
          assign field = product.metafields[namespace][key]
          assign field_value = field.value
        %}
        {% if field != blank %}
          <div class="product-meta__item" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label | default: field.key | replace: '_', ' ' | escape }}</dt>
            <dd>
              {% if field.type contains 'list.' %}
                {% for item in field_value %}
                  <span class="product-meta__pill">
                    {{ item.label | default: item.name | default: item.display_name | default: item }}
                  </span>
                {% endfor %}
              {% elsif field.type contains 'metaobject_reference' %}
                {{ field_value.label | default: field_value.name | default: field_value.display_name | default: field | metafield_tag }}
              {% else %}
                {{ field | metafield_tag }}
              {% endif %}
            </dd>
          </div>
        {% endif %}
      {% endfor %}
    </dl>
  </section>
{% endif %}

{% stylesheet %}
  .product-meta { width: min(calc(100% - 80px), var(--narrow-page-width)); margin-inline: auto; display: grid; grid-template-columns: minmax(180px, .55fr) minmax(0, 1.45fr); gap: 6vw; padding-block: 56px 72px; border-top: 1px solid rgb(var(--color-foreground-rgb) / .14); }
  .product-meta__heading p { margin: 0 0 10px; color: rgb(var(--color-foreground-rgb) / .6); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
  .product-meta__heading h2 { margin: 0; font-size: clamp(30px, 4vw, 48px); font-weight: 500; }
  .product-meta__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; margin: 0; }
  .product-meta__item { display: grid; grid-template-columns: minmax(100px, .7fr) 1fr; gap: 18px; padding: 17px 0; border-bottom: 1px solid rgb(var(--color-foreground-rgb) / .14); }
  .product-meta__item dt { color: rgb(var(--color-foreground-rgb) / .62); }
  .product-meta__item dd { margin: 0; }
  .product-meta__item .metafield-rich_text_field > :first-child { margin-top: 0; }
  .product-meta__item .metafield-rich_text_field > :last-child { margin-bottom: 0; }
  .product-meta__pill { display: inline-block; margin: 0 5px 5px 0; padding: 4px 9px; border: 1px solid rgb(var(--color-foreground-rgb) / .2); border-radius: 999px; }
  @media screen and (max-width: 749px) {
    .product-meta, .product-meta__grid { grid-template-columns: 1fr; }
    .product-meta { width: calc(100% - 32px); gap: 28px; padding-block: 42px 56px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product metafields",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" }
  ],
  "blocks": [
    {
      "type": "metafield",
      "name": "Metafield",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Detail" },
        { "type": "text", "id": "namespace", "label": "Namespace", "default": "custom" },
        { "type": "text", "id": "key", "label": "Key", "default": "detail" }
      ]
    }
  ],
  "presets": [{ "name": "Product metafields" }]
}
{% endschema %}
