DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# 采集器运行参数（均有默认值，可不填）
# 同一域名请求最小间隔（秒），契约要求 >=2
CRAWLER_MIN_INTERVAL=2
# 指数退避重试上限次数
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_BASE=2
CRAWLER_BACKOFF_MAX=60
# 单次请求超时（秒）
CRAWLER_TIMEOUT=30
# Playwright 是否无头
CRAWLER_HEADLESS=1
# 浏览器通道：chrome / msedge（用已安装浏览器，免下载）；留空则用 playwright install 的 chromium
CRAWLER_BROWSER_CHANNEL=chrome
# worker 空闲轮询间隔（秒）
CRAWLER_POLL_INTERVAL=5
# 真实可识别 User-Agent，契约指定 Chrome 156.0.8078.80
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.8078.80 Safari/537.36
CRAWLER_EBAY_BASE=https://www.ebay.com
# 可选代理（如 http://127.0.0.1:8118）；留空直连，忽略系统环境中损坏的代理变量
CRAWLER_PROXY=