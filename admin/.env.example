DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
SECRET_KEY=

# Shopify Custom App（同一组织下的多店铺共用；密钥禁止提交）
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# 公网 HTTPS 根地址；本机由 Apache TLS 8000 反代 Uvicorn 8001，路由器映射公网 10086 → 本机 8000
SHOPIFY_WEBHOOK_BASE_URL=https://admin.monozex.com:10086
SHOPIFY_REQUEST_TIMEOUT_SECONDS=30
SHOPIFY_MAX_RETRIES=3
# 后台商品图片的公网访问根地址；留空时复用 SHOPIFY_WEBHOOK_BASE_URL
SHOPIFY_ASSET_BASE_URL=
